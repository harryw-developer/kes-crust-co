---
// One hidden SVG sprite per page: topping drawings + UI icons, referenced with <use>.
import { TOPPINGS } from '../lib/toppings';
const S = 'fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"';
const icons: Record<string, string> = {
  heart: `<path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8.1 3.6 4.5 7 4.5c2.1 0 3.6 1.2 5 3 1.4-1.8 2.9-3 5-3 3.4 0 5.5 3.6 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" ${S}/>`,
  'heart-fill': `<path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8.1 3.6 4.5 7 4.5c2.1 0 3.6 1.2 5 3 1.4-1.8 2.9-3 5-3 3.4 0 5.5 3.6 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" fill="currentColor" stroke="#111" stroke-width="2" stroke-linejoin="round"/>`,
  pin: `<path d="M12 21.5s-7-6.2-7-11.8a7 7 0 0 1 14 0c0 5.6-7 11.8-7 11.8Z" ${S}/><circle cx="12" cy="9.7" r="2.6" ${S}/>`,
  calendar: `<rect x="3.5" y="5" width="17" height="15.5" rx="3" ${S}/><path d="M3.5 10h17M8 3v4M16 3v4" ${S}/>`,
  clock: `<circle cx="12" cy="12" r="8.5" ${S}/><path d="M12 7.5V12l3 2" ${S}/>`,
  arrow: `<path d="M4 12h15M13 6l6 6-6 6" ${S}/>`,
  pause: `<path d="M8.5 5v14M15.5 5v14" ${S} stroke-width="3"/>`,
  play: `<path d="M7 4.5v15l12-7.5Z" ${S} fill="currentColor"/>`,
  flip: `<path d="M4 9a8 8 0 0 1 14-3l2 2M20 15a8 8 0 0 1-14 3l-2-2" ${S}/><path d="M20 4v4h-4M4 20v-4h4" ${S}/>`,
  share: `<path d="M12 3v12M7.5 7.5 12 3l4.5 4.5M5 13v6.5h14V13" ${S}/>`,
  download: `<path d="M12 3v12M7.5 10.5 12 15l4.5-4.5M5 19.5h14" ${S}/>`,
  mail: `<rect x="3" y="5.5" width="18" height="13" rx="2.5" ${S}/><path d="m4 7 8 6 8-6" ${S}/>`,
  phone: `<path d="M6.5 3.5h3l1.5 4.5-2 1.5a11 11 0 0 0 5.5 5.5l1.5-2 4.5 1.5v3c0 1.4-1.1 2.5-2.5 2.5C10.6 20 4 13.4 4 6c0-1.4 1.1-2.5 2.5-2.5Z" ${S}/>`,
  insta: `<rect x="3.5" y="3.5" width="17" height="17" rx="5" ${S}/><circle cx="12" cy="12" r="4" ${S}/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/>`,
  shuffle: `<path d="M3 7h3.5c4.5 0 6.5 10 11 10H21M3 17h3.5c1.7 0 3-1.4 4-3.2M14 10.2c1-1.8 2.3-3.2 4-3.2H21M18 4l3 3-3 3M18 14l3 3-3 3" ${S}/>`,
  trash: `<path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13" ${S}/>`,
  wobble: `<path d="M3 12c2-4 4-4 6 0s4 4 6 0 4-4 6 0" ${S}/>`,
  drink: `<path d="M7 5.5c0-1.5 10-1.5 10 0v13c0 2-10 2-10 0Z" fill="#FF4F9A" stroke="#111" stroke-width="2" stroke-linejoin="round"/><path d="M7 10c3 1.5 7-1.5 10 0v4c-3-1.5-7 1.5-10 0Z" fill="#FFD23F" stroke="#111" stroke-width="1.6"/><ellipse cx="12" cy="5.5" rx="5" ry="1.4" fill="#E7E9EE" stroke="#111" stroke-width="1.6"/>`,
  check: `<path d="m4.5 12.5 5 5 10-11" ${S} stroke-width="3"/>`,
  slice: `<path d="M3 3l26 11c-2.5 7-8 12.5-15 15Z" fill="#FFD23F" stroke="#111" stroke-width="2.2" stroke-linejoin="round"/><path d="M29 14c-2.5 7-8 12.5-15 15l-1.6-4.2c5.5-2.2 10-6.6 12.4-12.4Z" fill="#E9B36A" stroke="#111" stroke-width="2.2" stroke-linejoin="round"/><circle cx="11" cy="11" r="2.6" fill="#C62F2F" stroke="#111" stroke-width="1.4"/><circle cx="17" cy="17.5" r="2.4" fill="#C62F2F" stroke="#111" stroke-width="1.4"/><circle cx="10" cy="20" r="1.8" fill="#C62F2F" stroke="#111" stroke-width="1.4"/>`,
};
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {Object.entries(TOPPINGS).map(([k, t]) => <symbol id={`t-${k}`} viewBox="0 0 40 40" set:html={t.svg} />)}
    {Object.entries(icons).map(([k, svg]) => <symbol id={`i-${k}`} viewBox={k === 'slice' ? '0 0 32 32' : '0 0 24 24'} set:html={svg} />)}
  </defs>
</svg>
