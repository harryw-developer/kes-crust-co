---
// The original KES Crust Co. logo file, only trimmed and resized (never redrawn or recoloured).
import { u } from '../lib/paths';
interface Props { sizes?: string; alt?: string; class?: string; eager?: boolean; width?: number }
const { sizes = '160px', alt = 'KES Crust Co.', class: cls, eager = false } = Astro.props;
---
<picture class:list={['kes-logo', cls]}>
  <source type="image/webp" srcset={`${u('/brand/kes-logo-160.webp')} 160w, ${u('/brand/kes-logo-320.webp')} 320w, ${u('/brand/kes-logo-582.webp')} 582w`} sizes={sizes} />
  <img src={u('/brand/kes-logo-trim.png')} width="582" height="570" alt={alt} loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : undefined} />
</picture>
