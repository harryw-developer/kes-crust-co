---
import site from '../data/site.json';
import { u } from '../lib/paths';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import PizzaArt from './PizzaArt.astro';
import menu from '../data/menu.json';

const insta = `https://www.instagram.com/${site.instagram}/`;
const tiles = menu.items.filter((i) => i.category !== 'side').slice(0, 6);
const tileColours = ['var(--yellow)', 'var(--pink)', 'var(--green)', 'var(--orange)', 'var(--cream)', 'var(--yellow)'];
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer-grid">
      <section class="club sticker" aria-labelledby="club-title" data-reveal>
        <p class="label">Free to join · Dates first</p>
        <h2 id="club-title">Join the Crust&nbsp;Club</h2>
        <p style="margin-top:10px;max-width:42ch">We only pop up a few times a year. Join and you'll hear about new dates first. No spam, ever.</p>
        <form class="inline-form" name="crust-club" method="POST" action="#" data-ajax-form>
          <p hidden><label>Leave this empty <input name="bot-field" /></label></p>
          <label class="field">
            <span class="sr-only">Email address</span>
            <input class="input" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
          </label>
          <button class="btn" type="submit">Join the Crust Club</button>
          <p class="form-success" role="status" hidden><Icon name="check" /> You're in. Welcome to the Club.</p>
          <p class="error-msg" role="alert" hidden></p>
        </form>
        <p class="form-note">We'll only use your email for Crust Club news. Unsubscribe any time. <a href={u('/privacy')}>Privacy notice</a>.</p>
      </section>

      <div class="stack" style="--gap:28px">
        <section aria-labelledby="insta-title">
          <p class="label accent">Follow the smoke</p>
          <h2 id="insta-title" style="font-size:clamp(1.9rem,5vw,2.8rem);margin-top:6px">
            <a href={insta} rel="noopener" style="text-decoration:none">@{site.instagram}</a>
          </h2>
          <ul class="insta-grid" role="list">
            {tiles.map((t, i) => (
              <li>
                <a class="insta-tile" href={insta} rel="noopener" style={`background:${tileColours[i]};--r:${[-3, 2, -1, 3, -2, 1][i]}deg`} aria-label={`${t.name} on Instagram`}>
                  <PizzaArt art={t.art as any} seed={t.id} />
                </a>
              </li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="contact-title">
          <h3 id="contact-title" class="accent">Shout at us (nicely)</h3>
          <ul class="contact-list" role="list" style="margin-top:6px">
            <li><a href={`mailto:${site.email}`}><Icon name="mail" class="ci" />&nbsp;{site.email}</a></li>
            <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" class="ci" />&nbsp;{site.phone}</a></li>
            <li><a href={insta} rel="noopener"><Icon name="insta" class="ci" />&nbsp;Instagram DMs are open</a></li>
          </ul>
        </section>
      </div>
    </div>

    <div class="footer-meta">
      <button class="rose-stamp" type="button" data-rose aria-label="KES Crust Co. logo">
        <Logo sizes="96px" alt="" />
      </button>
      <ul class="footer-links" role="list">
        <li><a href={u('/find-us')}>Find us</a></li>
        <li><a href={u('/menu')}>Menu &amp; allergens</a></li>
        <li><a href={u('/events')}>Events</a></li>
        <li><a href={u('/about')}>About</a></li>
        <li><a href={u('/build-a-pizza')}>Build-a-Pizza</a></li>
        <li><a href={u('/privacy')}>Privacy</a></li>
      </ul>
      <div style="display:grid;gap:10px;justify-items:start">
        <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false">
          <Icon name="pause" /> <span>Pause animations</span>
        </button>
        <small>© {new Date().getFullYear()} {site.name}. Made with fire.</small>
      </div>
    </div>
  </div>
</footer>

<style>
  :global(.ci) { width: 22px; height: 22px; }
  .site-footer h3 { font-size: 1.4rem; }
</style>
